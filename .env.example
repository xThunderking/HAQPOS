# Copy to .env in the repository root. This file contains no real secrets.
POSTGRES_DB=haqpos
POSTGRES_USER=haqpos
POSTGRES_PASSWORD=
# 55432 avoids conflicts with an existing PostgreSQL on 5432.
POSTGRES_PORT=55432
APP_HOST=haqpos.hospital.local
# Keep loopback until TI explicitly assigns an internal LAN address and firewall.
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
TLS_CERT_PATH=/etc/haqpos/tls/fullchain.pem
TLS_KEY_PATH=/etc/haqpos/tls/privkey.pem
