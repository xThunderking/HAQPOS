{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "api/health",
      "applicationUrl": "https://localhost:7143;http://localhost:5143",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_HTTPS_PORT": "7143",
        "Kestrel__Certificates__Default__Path": "../../.tools/certs/localhost.pem",
        "Kestrel__Certificates__Default__KeyPath": "../../.tools/certs/localhost.key"
      }
    }
  }
}
